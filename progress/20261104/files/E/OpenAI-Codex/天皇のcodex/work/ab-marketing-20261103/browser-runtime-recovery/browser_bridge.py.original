import json
import pathlib
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

ROOT = pathlib.Path(__file__).parent
proc = subprocess.Popen([
    r'D:/node.exe', '--max-old-space-size=6144',
    r'E:/OpenAI-Codex/Integrations/ChromeDevToolsMCP/node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js',
    '--autoConnect', '--no-usage-statistics', '--no-performance-crux',
    '--no-source-maps', '--no-category-network',
    '--no-category-performance', '--no-category-emulation', '--no-category-memory',
    '--redact-network-headers', '--workspace=E:/OpenAI-Codex/天皇のcodex',
], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=(ROOT / 'browser-bridge-stderr.log').open('ab'),
    text=True, encoding='utf-8', creationflags=subprocess.CREATE_NO_WINDOW)

lock = threading.Lock()
responses = {}
operations = {}
sequence = 0

def reader():
    for line in proc.stdout:
        try:
            response = json.loads(line)
            if 'id' in response:
                responses[response['id']] = response
        except Exception:
            pass

threading.Thread(target=reader, daemon=True).start()

def request(method, params):
    global sequence
    with lock:
        sequence += 1
        ident = sequence
        proc.stdin.write(json.dumps({'jsonrpc': '2.0', 'id': ident, 'method': method, 'params': params}, ensure_ascii=False) + '\n')
        proc.stdin.flush()
    while ident not in responses:
        if proc.poll() is not None:
            raise RuntimeError('Browser tool process exited')
        time.sleep(0.05)
    return responses.pop(ident)

request('initialize', {'protocolVersion':'2024-11-05', 'capabilities':{}, 'clientInfo':{'name':'codex-ab-marketing-durable', 'version':'1'}})
proc.stdin.write(json.dumps({'jsonrpc':'2.0', 'method':'notifications/initialized'}) + '\n')
proc.stdin.flush()

def run_operation(ident, name, arguments):
    try:
        result = request('tools/call', {'name':name, 'arguments':arguments})
        operations[ident].update(status='complete', result=result)
    except Exception as exc:
        operations[ident].update(status='error', error=str(exc))

class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def send(self, value):
        body = json.dumps(value, ensure_ascii=False).encode('utf-8')
        self.send_response(200)
        self.send_header('Content-Type', 'application/json; charset=utf-8')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == '/status':
            return self.send({'alive':proc.poll() is None, 'operations':[{k:v for k,v in op.items() if k != 'result'} for op in operations.values()]})
        ident = self.path.removeprefix('/operation/')
        self.send(operations.get(ident, {'status':'unknown'}))

    def do_POST(self):
        data = json.loads(self.rfile.read(int(self.headers['Content-Length'])))
        ident = str(time.time_ns())
        operations[ident] = {'id':ident, 'name':data['name'], 'status':'pending'}
        threading.Thread(target=run_operation, args=(ident,data['name'],data.get('arguments',{})), daemon=True).start()
        self.send({'id':ident, 'status':'pending'})

ThreadingHTTPServer(('127.0.0.1',8768), Handler).serve_forever()
